{
  "manifest_version": 3,
  "name": "Send to TV",
  "description": "Plays the current YouTube video in SmartTube on the TV.",
  "version": "1.0",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": { "default_title": "Play in SmartTube on the TV" },
  "background": { "service_worker": "background.js" }
}
